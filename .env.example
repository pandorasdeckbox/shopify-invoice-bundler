# Shopify app credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Public base URL for this app.
# Local dev: set this to your cloudflared tunnel URL.
# Production: set this to your Railway/custom domain base URL.
APP_URL=https://your-app-url.example.com

PORT=3000
NODE_ENV=development

# Local dev: leave unset to use SQLite.
# Railway: Railway injects DATABASE_URL automatically when Postgres is attached.
DATABASE_URL=